{
  "manifest_version": 3,
  "name": "Snipkey – Text Expander",
  "short_name": "Snipkey",
  "version": "1.0.0",
  "description": "Type a short shortcut, get the full text. Fast, private text expander with a one-time Pro unlock. No account.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snipkey",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "clipboardRead"],
  "host_permissions": ["https://api.lemonsqueezy.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
